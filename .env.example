# =============================================================================
# AI Video Studio — Environment Configuration
# Copy this file to .env and fill in the values.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=AI Video Studio
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-in-production-use-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aivideo
POSTGRES_PASSWORD=aivideo_secret
POSTGRES_DB=aivideo_studio
DATABASE_URL=postgresql+asyncpg://aivideo:aivideo_secret@postgres:5432/aivideo_studio
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=360
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# -----------------------------------------------------------------------------
# Google AI Providers
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=3
GEMINI_REQUEST_TIMEOUT=120

# Set USE_VEO=true to generate AI video clips per scene instead of still
# images.  Falls back to GEMINI_API_KEY when GOOGLE_VEO_API_KEY is unset.
# NOTE: veo-3.1-fast-generate-preview was shut down on 2026-10-22 —
# update GOOGLE_VEO_MODEL to a supported endpoint before enabling.
USE_VEO=false
GOOGLE_VEO_API_KEY=
GOOGLE_VEO_MODEL=veo-3.1-fast-generate-preview
GOOGLE_VEO_MAX_RETRIES=2
GOOGLE_VEO_REQUEST_TIMEOUT=600

# Kling v3 via fal.ai — primary video provider when USE_KLING=true.
# Endpoint base selects the tier: fal-ai/kling-video/v3/standard or
# fal-ai/kling-video/v3/pro
USE_KLING=false
FAL_KEY=
KLING_ENDPOINT=fal-ai/kling-video/v3/standard
KLING_MODEL=kling-v3-standard
KLING_MAX_RETRIES=2
KLING_REQUEST_TIMEOUT=600
KLING_GENERATE_AUDIO=true
# Frontend hint for the direct-cinematic beat planner (kling | veo)
NEXT_PUBLIC_VIDEO_PROVIDER=kling

GOOGLE_IMAGEN_API_KEY=
GOOGLE_IMAGEN_MODEL=imagen-3.0
GOOGLE_IMAGEN_MAX_RETRIES=3
GOOGLE_IMAGEN_REQUEST_TIMEOUT=120

GOOGLE_TTS_API_KEY=
GOOGLE_TTS_LANGUAGE=en-US
GOOGLE_TTS_VOICE=en-US-Studio-Q
GOOGLE_TTS_MAX_RETRIES=3
GOOGLE_TTS_REQUEST_TIMEOUT=60

# -----------------------------------------------------------------------------
# YouTube Data API (Publishing)
# -----------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/publish/oauth/callback
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# Cloud Storage (for generated assets)
# -----------------------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/storage
# GCS
STORAGE_GCS_BUCKET=
STORAGE_GCS_PROJECT_ID=
STORAGE_GCS_CREDENTIALS_PATH=
# S3
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# -----------------------------------------------------------------------------
# FFmpeg
# -----------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_THREADS=4
FFMPEG_PRESET=medium
FFMPEG_CRF=23

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AI_ENDPOINTS=10/minute

# -----------------------------------------------------------------------------
# Cost Tracking (per-unit costs in USD — used for budget estimation)
# -----------------------------------------------------------------------------
COST_GEMINI_PRO_INPUT_PER_1K=0.00125
COST_GEMINI_PRO_OUTPUT_PER_1K=0.005
COST_GEMINI_FLASH_INPUT_PER_1K=0.0003
COST_GEMINI_FLASH_OUTPUT_PER_1K=0.0015
COST_VEO_PER_SECOND=0.10
# Kling v3 standard on fal.ai, audio on: $0.126/s (pro tier: $0.168/s)
COST_KLING_PER_SECOND=0.126
COST_IMAGEN_PER_IMAGE=0.04
COST_TTS_PER_1K_CHARS=0.016

# -----------------------------------------------------------------------------
# Langfuse — LLM tracing and observability
# -----------------------------------------------------------------------------
# Set LANGFUSE_ENABLED=true and provide keys to send traces.
# For self-hosted, point LANGFUSE_HOST at your Langfuse instance
# (e.g. http://langfuse:3000 when running via docker-compose).
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_RELEASE=0.1.0

# Grafana Cloud Loki log shipping
LOKI_ENABLED=false
LOKI_URL=
LOKI_USER=
LOKI_API_KEY=
